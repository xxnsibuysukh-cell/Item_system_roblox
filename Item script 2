-- รายชิ้นเป้าหมายที่จะดึง: ชิ้นที่เลือกไว้ (ตามลำดับ) + ชิ้นที่คล้าย (ถ้าเปิด)
local function getTargets()
	local list, sel = {}, {}
	for _, d in pairs(selected) do
		sel[#sel + 1] = d
	end
	table.sort(sel, function(a, b)
		return a.order < b.order
	end)
	for _, d in ipairs(sel) do
		list[#list + 1] = d.part
	end
	if S.bringSimilar then
		for _, p in ipairs(luckyParts) do
			if p.Parent and not selected[p] then
				list[#list + 1] = p
			end
		end
	end
	return list
end

local function allSelectedParts()
	local list = {}
	for p in pairs(selected) do
		list[#list + 1] = p
	end
	return list
end

