local FAST = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SMOOTH = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local PRESS = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

-- ระบบธีม: ค่า "@key" จะผูกกับ THEME[key] และเปลี่ยนตามเมื่อแก้สี GUI
local binds, hooks = {}, {}

local function bind(inst, prop, key)
	binds[#binds + 1] = { inst = inst, prop = prop, key = key }
	inst[prop] = THEME[key]
end

local function col(v)
	if type(v) == "string" then
		return THEME[v:sub(2)]
	end
	return v
end

local function new(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		if type(value) == "string" and value:sub(1, 1) == "@" then
			bind(inst, key, value:sub(2))
		else
			inst[key] = value
		end
	end
	inst.Parent = parent
	return inst
end

local function round(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function gradient(parent, c1, c2, rotation)
	local g = new("UIGradient", { Rotation = rotation or 0 }, parent)
	local function apply()
		g.Color = ColorSequence.new(col(c1), col(c2))
	end
	apply()
	if type(c1) == "string" or type(c2) == "string" then
		hooks[#hooks + 1] = apply
	end
	return g
end

local function applyTheme()
	for _, b in ipairs(binds) do
		b.inst[b.prop] = THEME[b.key]
	end
	for _, fn in ipairs(hooks) do
		fn()
	end
end

local function setAccent(c)
	local h, s, v = c:ToHSV()
	THEME.accent = c
	THEME.accentHover = c:Lerp(Color3.new(1, 1, 1), 0.3)
	THEME.accent2 = Color3.fromHSV((h + 0.12) % 1, s, v)
	THEME.accent2Hover = THEME.accent2:Lerp(Color3.new(1, 1, 1), 0.3)
	applyTheme()
end

local function setBackground(preset)
	for _, k in ipairs({ "panel", "header", "card", "button", "buttonHover", "off" }) do
		THEME[k] = preset[k]
	end
	applyTheme()
end

local function addButtonFx(button, base, hover)
	button.AutoButtonColor = false
	if type(base) == "string" then
		bind(button, "BackgroundColor3", base:sub(2))
	else
		button.BackgroundColor3 = base
	end
	local scale = new("UIScale", { Scale = 1 }, button)
	button.MouseEnter:Connect(function()
		tween(button, FAST, { BackgroundColor3 = col(hover) })
	end)
	button.MouseLeave:Connect(function()
		tween(button, FAST, { BackgroundColor3 = col(base) })
		tween(scale, FAST, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		tween(scale, PRESS, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		tween(scale, SPRING, { Scale = 1 })
	end)
end

local function makeButton(parent, text, size, position, base, hover, font, textSize, order)
	local b = new("TextButton", {
		Size = size,
		Position = position or UDim2.new(),
		Font = font or Enum.Font.GothamMedium,
		Text = text,
		TextColor3 = THEME.text,
		TextSize = textSize or 11,
		BorderSizePixel = 0,
		LayoutOrder = order or 0,
	}, parent)
	round(b, 7)
	addButtonFx(b, base or "@button", hover or "@buttonHover")
	return b
end

