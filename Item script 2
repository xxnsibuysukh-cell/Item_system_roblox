local refreshQueued = false
scheduleRefresh = function()
	if refreshQueued then return end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		updateBadges()
		updateNav()
		for part in pairs(luckyMap) do syncLuckyVisibility(part) end
		refreshStatus()
	end)
end

