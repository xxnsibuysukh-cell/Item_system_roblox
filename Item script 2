---------------------------------------------------------------------
-- ชิ้นแรก ๆ ใช้ Highlight (มีเส้นขอบ) ชิ้นที่เกินลิมิตใช้ BoxHandleAdornment (ทะลุกำแพงได้ ไม่จำกัดจำนวน)
local function createEsp(part, color)
	local hl, box
	if highlightCount < HIGHLIGHT_LIMIT then
		hl = Instance.new("Highlight")
		hl.Name = "IB_ESP"
		hl.Adornee = part
		hl.FillColor = color
		hl.OutlineColor = color
		hl.FillTransparency = S.espFill
		hl.OutlineTransparency = S.espOutline
		hl.DepthMode = S.espWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		hl.Parent = part
		highlightCount += 1
	else
		box = Instance.new("BoxHandleAdornment")
		box.Name = "IB_ESP_BOX"
		box.Adornee = part
		box.Size = part.Size
		box.Color3 = color
		box.Transparency = math.clamp(S.espFill, 0.1, 1)
		box.AlwaysOnTop = S.espWalls
		box.ZIndex = 5
		box.Parent = part
	end

	local bb = Instance.new("BillboardGui")
	bb.Name = "IB_LABEL"
	bb.Adornee = part
	bb.AlwaysOnTop = true
	bb.Size = UDim2.fromOffset(150, 32)
	bb.StudsOffsetWorldSpace = Vector3.new(0, part.Size.Y / 2 + 2, 0)
	bb.LightInfluence = 0
	bb.Parent = part
	local txt = new("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = color,
		TextStrokeTransparency = 0.3,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		Text = shortName(part.Name),
	}, bb)
	return hl, box, bb, txt
end

local function syncLuckyVisibility(part)
	local box = luckyMap[part]
	if box and box.Parent then
		box.Visible = scriptOn and S.showSimilar and not selected[part]
	end
end

local function updateBadges()
	badge.Visible = selectedCount > 0
	badge.Text = tostring(selectedCount)
end

local function updateNav()
	local n = #getTargets()
	bringButton.Text = ("⇩  Bring all targets (%d)"):format(n)
	tween(bringButton, FAST, { TextTransparency = n > 0 and 0 or 0.6 })
end

local onLost

local function selectPart(part, color)
	if not part or selected[part] or not part.Parent then
		return false
	end
	color = color or pickColor
	selOrder += 1
	local hl, box, bb, txt = createEsp(part, color)
	local data = { part = part, hl = hl, box = box, bb = bb, txt = txt, color = color, order = selOrder }
	data.conn = part.AncestryChanged:Connect(function()
		if not part:IsDescendantOf(Workspace) then
			onLost(part)
		end
	end)
	selected[part] = data
	selectedCount += 1
	syncLuckyVisibility(part)
	scheduleRefresh()
	return true
end

local function deselectPart(part)
	local d = selected[part]
	if not d then
		return nil
	end
	selected[part] = nil
	selectedCount -= 1
	if d.conn then d.conn:Disconnect() end
	if d.hl then
		d.hl:Destroy()
		highlightCount -= 1
	end
	if d.box then d.box:Destroy() end
	if d.bb then d.bb:Destroy() end
	syncLuckyVisibility(part)
	scheduleRefresh()
	return d.color
end

onLost = function(part)
	local d = selected[part]
	if not d then
		return
	end
	origins[part] = nil
	if S.autoRefind then
		table.insert(pending, {
			Name = part.Name,
			ClassName = part.ClassName,
			Size = part.Size,
			Position = part.Position,
			Color = d.color,
		})
		if #pending > 300 then
			table.remove(pending, 1)
		end
	end
	deselectPart(part)
end

local function matchesSig(inst, sig)
	return inst.Name == sig.Name
		and inst.ClassName == sig.ClassName
		and (inst.Size - sig.Size).Magnitude < 0.25
		and (inst.Position - sig.Position).Magnitude <= 8
end

local function tryRefind(inst)
	if selected[inst] then
		return false
	end
	for i = #pending, 1, -1 do
		if matchesSig(inst, pending[i]) then
			local color = pending[i].Color
			table.remove(pending, i)
			return selectPart(inst, color)
		end
	end
	return false
end

Workspace.DescendantAdded:Connect(function(inst)
	if not S.autoRefind or #pending == 0 or not inst:IsA("BasePart") then
		return
	end
	task.delay(0.12, function()
		if inst.Parent and #pending > 0 then
			tryRefind(inst)
		end
	end)
end)

setColor = function(part, color)
	local d = selected[part]
	if not d then
		return
	end
	d.color = color
	if d.hl then
		d.hl.FillColor = color
		d.hl.OutlineColor = color
	end
	if d.box then
		d.box.Color3 = color
	end
	d.txt.TextColor3 = color
end

-- history
local function updateHistoryButtons()
	tween(undoButton, FAST, { TextTransparency = #undoStack > 0 and 0 or 0.6 })
	tween(redoButton, FAST, { TextTransparency = #redoStack > 0 and 0 or 0.6 })
end

local function pushHistory(entry)
	if #entry.added == 0 and #entry.removed == 0 then
		return
	end
	table.insert(undoStack, entry)
	if #undoStack > HISTORY_LIMIT then
		table.remove(undoStack, 1)
	end
	redoStack = {}
	updateHistoryButtons()
end

local function applyEntry(entry, reverse)
	local toAdd = reverse and entry.removed or entry.added
	local toRemove = reverse and entry.added or entry.removed
	for _, it in ipairs(toRemove) do deselectPart(it.part) end
	for _, it in ipairs(toAdd) do selectPart(it.part, it.color) end
end

undoButton.MouseButton1Click:Connect(function()
	local entry = table.remove(undoStack)
	if not entry then return end
	applyEntry(entry, true)
	table.insert(redoStack, entry)
	updateHistoryButtons()
end)
redoButton.MouseButton1Click:Connect(function()
	local entry = table.remove(redoStack)
	if not entry then return end
	applyEntry(entry, false)
	table.insert(undoStack, entry)
	updateHistoryButtons()
end)

local function removeParts(partList)
	local entry = { added = {}, removed = {} }
	for _, p in ipairs(partList) do
		local c = deselectPart(p)
		if c then
			table.insert(entry.removed, { part = p, color = c })
		end
	end
	pushHistory(entry)
end

---------------------------------------------------------------------
-- Lucky (similar search)
---------------------------------------------------------------------
local function makeBox(part, color)
	local box = Instance.new("SelectionBox")
	box.Name = "IB_SIMILAR"
	box.Color3 = color
	box.SurfaceColor3 = color
	box.LineThickness = 0.04
	box.Adornee = part
	box.Parent = part
	return box
end

local function fadeInBox(box, animate)
	if animate then
		box.SurfaceTransparency = 1
		box.Transparency = 1
		tween(box, FADE, { SurfaceTransparency = 0.8, Transparency = 0 })
	else
		box.SurfaceTransparency = 0.8
		box.Transparency = 0
	end
end

local function clearLucky()
	local animate = #luckyMarkers <= ANIMATE_LIMIT
	for _, box in ipairs(luckyMarkers) do
		if animate and box.Parent then
			local t = tween(box, FADE, { SurfaceTransparency = 1, Transparency = 1 })
			t.Completed:Once(function() box:Destroy() end)
		else
			box:Destroy()
		end
	end
	luckyMarkers, luckyParts, luckyMap = {}, {}, {}
	luckySearched = false
	updateNav()
	scheduleRefresh()
end

local function sortedSize(p)
	local s = p.Size
	local t = { s.X, s.Y, s.Z }
	table.sort(t)
	return t
end

local function runLucky()
	if luckyBusy then return end
	if not scriptOn then notify("Turn on Script power first") return end
	if selectedCount == 0 then notify("Select something first") return end
	luckyBusy = true
	clearLucky()

	local refs = {}
	for part in pairs(selected) do
		table.insert(refs, {
			cls = part.ClassName,
			name = part.Name,
			mesh = part:IsA("MeshPart") and part.MeshId or nil,
			mat = part.Material,
			col = part.Color,
			sz = sortedSize(part),
		})
	end
	local chars = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then table.insert(chars, pl.Character) end
	end
	local tol = S.similarTol

	local found = {}
	local all = Workspace:GetDescendants()
	for i, inst in ipairs(all) do
		if inst:IsA("BasePart") and not inst:IsA("Terrain") and not selected[inst] then
			for _, ref in ipairs(refs) do
				if inst.ClassName == ref.cls
					and (inst.Name == ref.name or (inst.Material == ref.mat and inst.Color == ref.col))
					and (not ref.mesh or inst.MeshId == ref.mesh)
				then
					local sz = sortedSize(inst)
					if math.abs(sz[1] - ref.sz[1]) <= tol and math.abs(sz[2] - ref.sz[2]) <= tol and math.abs(sz[3] - ref.sz[3]) <= tol then
						local inChar = false
						for _, c in ipairs(chars) do
							if inst:IsDescendantOf(c) then inChar = true break end
						end
						if not inChar then
							table.insert(found, inst)
						end
						break
					end
				end
			end
			if #found >= MAX_LUCKY then break end
		end
		if i % 4000 == 0 then task.wait() end
	end

	local hrp = getHRP()
	if hrp then
		local origin = hrp.Position
		table.sort(found, function(a, b)
			return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
		end)
	end

	local animate = #found <= ANIMATE_LIMIT
	for _, part in ipairs(found) do
		local box = makeBox(part, luckyColor)
		fadeInBox(box, animate)
		table.insert(luckyMarkers, box)
		luckyMap[part] = box
		syncLuckyVisibility(part)
	end
	luckyParts = found
	luckySearched = true
	luckyBusy = false
	updateNav()
	scheduleRefresh()
	refreshStatus()
end
luckyButton.MouseButton1Click:Connect(runLucky)

addSimilarButton.MouseButton1Click:Connect(function()
	if #luckyParts == 0 then
		notify("Press I'm Feeling Lucky! first")
		return
	end
	local entry = { added = {}, removed = {} }
	for _, p in ipairs(luckyParts) do
		if selectPart(p, pickColor) then
			table.insert(entry.added, { part = p, color = pickColor })
		end
	end
	pushHistory(entry)
	clearLucky()
	notify(("Added %d to selection (ESP)"):format(#entry.added), true)
end)

---------------------------------------------------------------------
-- BRING (ดึง part / Model มาหาตัว)
---------------------------------------------------------------------
-- คำนวณตำแหน่งของชิ้นที่ i จากทั้งหมด n ตามรูปแบบ Layout (รอบ ๆ ตัวผู้เล่น)
local function layoutCFrame(i, n, inst, hrp)
	local base = hrp.CFrame
	local pv = inst:GetPivot()
	local rot = pv - pv.Position
	local pos
	if S.layout == "Circle" then
		local a = (i - 1) / math.max(n, 1) * math.pi * 2
		pos = base.Position + Vector3.new(math.cos(a) * S.bringDist, S.bringHeight, math.sin(a) * S.bringDist)
	elseif S.layout == "Stack" then
		pos = (base * CFrame.new(0, S.bringHeight + (i - 1) * S.spacing, -S.bringDist)).Position
	else -- Grid ด้านหน้าตัว
		local cols = math.max(1, math.ceil(math.sqrt(n)))
		local r = math.floor((i - 1) / cols)
		local c = (i - 1) % cols
		pos = (base * CFrame.new((c - (cols - 1) / 2) * S.spacing, S.bringHeight, -(S.bringDist + r * S.spacing))).Position
	end
	return CFrame.new(pos) * rot
end

-- ย้ายชิ้นเดียว (BasePart ใช้ CFrame/Tween, Model ใช้ PivotTo) และจำตำแหน่งเดิมไว้ให้ Return
local function moveTo(inst, cf, glide)
	if not origins[inst] then
		origins[inst] = {
			cf = inst:GetPivot(),
			cc = inst:IsA("BasePart") and inst.CanCollide or nil,
		}
	end
	if inst:IsA("BasePart") then
		if S.noCollide then
			inst.CanCollide = false
		end
		inst.AssemblyLinearVelocity = Vector3.zero
		inst.AssemblyAngularVelocity = Vector3.zero
		if glide and S.glideTime > 0.01 then
			tween(inst, TweenInfo.new(S.glideTime, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), { CFrame = cf })
		else
			inst.CFrame = cf
		end
	else
		inst:PivotTo(cf)
	end
end

local function bringAll()
	if not scriptOn then notify("Turn on Script power first") return end
	local hrp = getHRP()
	if not hrp then notify("Character not found") return end
	local list = getTargets()
	local n = #list
	if n == 0 then notify("Select objects first") return end
	local glide = n <= ANIMATE_LIMIT
	local count = 0
	for i, p in ipairs(list) do
		if p.Parent then
			moveTo(p, layoutCFrame(i, n, p, hrp), glide)
			count += 1
		end
	end
	notify(("Brought %d part(s)\nLayout: %s"):format(count, S.layout), true)
end
bringButton.MouseButton1Click:Connect(bringAll)

local function returnAll()
	holdToggle.set(false)
	local count = 0
	for inst, o in pairs(origins) do
		if inst.Parent then
			if o.cc ~= nil then
				inst.AssemblyLinearVelocity = Vector3.zero
				inst.AssemblyAngularVelocity = Vector3.zero
				inst.CFrame = o.cf
				inst.CanCollide = o.cc
			else
				inst:PivotTo(o.cf)
			end
			count += 1
		end
	end
	origins = {}
	notify(("Returned %d item(s)"):format(count), true)
end
returnButton.MouseButton1Click:Connect(returnAll)

layoutButton.MouseButton1Click:Connect(function()
	local idx = table.find(LAYOUTS, S.layout) or 1
	S.layout = LAYOUTS[idx % #LAYOUTS + 1]
	layoutButton.Text = "Layout: " .. S.layout
end)

-- Hold: ดึงค้างให้ตามตัวตลอด (อัปเดตรายการเป้าหมายทุก 0.5 วิ)
local holdAcc = 0
RunService.Heartbeat:Connect(function(dt)
	if not holding or not scriptOn then return end
	local hrp = getHRP()
	if not hrp then return end
	holdAcc += dt
	if holdAcc >= 0.5 or #holdList == 0 then
		holdAcc = 0
		holdList = {}
		for i, p in ipairs(getTargets()) do
			if i > MAX_HOLD then break end
			holdList[#holdList + 1] = p
		end
		refreshStatus()
	end
	local n = #holdList
	for i, p in ipairs(holdList) do
		if p.Parent then
			moveTo(p, layoutCFrame(i, n, p, hrp), false)
		end
	end
end)

