	for _, d in pairs(selected) do
		if d.hl then
			d.hl.FillTransparency = S.espFill
			d.hl.OutlineTransparency = S.espOutline
			d.hl.DepthMode = S.espWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
		elseif d.box then
			d.box.Transparency = math.clamp(S.espFill, 0.1, 1)
			d.box.AlwaysOnTop = S.espWalls
		end
	end
end

