local acc = 0
RunService.Heartbeat:Connect(function(dt)
	acc += dt
	if acc < 0.1 then return end
	acc = 0
	local hrp = getHRP()
	local on = scriptOn and espOn
	for part, d in pairs(selected) do
		if part.Parent then
			local dist = hrp and (part.Position - hrp.Position).Magnitude or 0
			local visible = on and (not hrp or dist <= S.espMaxDist)
			if d.hl then d.hl.Enabled = visible end
			if d.box then d.box.Visible = visible end
			d.bb.Enabled = visible and S.espLabels
			if visible and S.espLabels and hrp then
				d.txt.Text = ("%s\n%d studs"):format(shortName(part.Name), math.floor(dist))
			end
		end
	end
end)

