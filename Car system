	return math.max(1 / (1 + r * r), cfg.steerMin) end
local function bottomY(part) local cf, s = part.CFrame, part.Size local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	local ext = (math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z) * 0.5 return cf.Position.Y - ext end
local function setupVehicle(seat, root) orientOK = seat.CFrame.UpVector.Y > 0.6 local model = seat:FindFirstAncestorOfClass("Model") local depth = 0
	while model and model.Parent and model.Parent ~= Workspace and model.Parent:IsA("Model") and depth < 3 do model = model.Parent depth = depth + 1 end
	rayParams = RaycastParams.new() rayParams.FilterType = Enum.RaycastFilterType.Exclude rayParams.RespectCanCollide = true
	local ignore = { model or seat } if player.Character then ignore[#ignore + 1] = player.Character end rayParams.FilterDescendantsInstances = ignore
	local base = root or seat local lowest = math.huge local function scan(list) local n = 0 for _, d in ipairs(list) do
			if d:IsA("BasePart") and d.CanCollide then local y = bottomY(d) if y < lowest then lowest = y end n = n + 1 if n > 2500 then break end end end end
	local okParts, connected = pcall(function() return seat:GetConnectedParts(true) end) if okParts and type(connected) == "table" then scan(connected)
	end if model then local desc = model:GetDescendants() if #desc <= 1500 then scan(desc) end end restOffset = 3 if lowest < math.huge then
		restOffset = math.clamp(base.Position.Y - lowest, 0.5, 25) end lpVy = base.AssemblyLinearVelocity.Y lpW = Vector3.zero end
local function driveVehicle(seat, root, dt) local vel = root.AssemblyLinearVelocity local w = root.AssemblyAngularVelocity
	local dirtyV, dirtyW = false, false local speed0 = vel.Magnitude local vy0 = vel.Y local rest0 = Vector3.new(w.X, 0, w.Z) local cfv = seat.CFrame
	local upv = cfv.UpVector local look = cfv.LookVector local upDot = upv.Y local stab = cfg.stabEnabled and orientOK local str = cfg.stabStrength
	local guard = cfg.stabEnabled and cfg.impactGuard if guard and prevVel then local pf = Vector3.new(prevVel.X, 0, prevVel.Z)
		local nf = Vector3.new(vel.X, 0, vel.Z) local pm = pf.Magnitude if pm > 25 then local drop = pm - nf.Magnitude local change = (nf - pf).Magnitude
			local d = math.max(dt, 0.008) if (drop / d > 700 and drop > pm * 0.18) or (change / d > 900 and change > pm * 0.25) then impactT = IMPACT_TIME
				impactVy = math.max(prevVel.Y, 0) end end end if not guard then impactT = 0 end local impactF = 0 if impactT > 0 then
		impactT = math.max(impactT - dt, 0) impactF = impactT / IMPACT_TIME end tele.crash = impactF > 0 local grounded, normal = true, Vector3.yAxis
	if stab and rayParams then local res = Workspace:Raycast(root.Position, Vector3.new(0, -80, 0), rayParams) local gap = 999 if res then
			gap = res.Distance - restOffset * math.max(upDot, 0.3) if res.Normal.Y > 0.5 then normal = res.Normal end end grounded = gap < 3.5 end
	tele.grounded = grounded local fwd = Vector3.new(look.X, 0, look.Z) local hasFwd = fwd.Magnitude > 0.1 if hasFwd then fwd = fwd.Unit end
	local right = hasFwd and fwd:Cross(Vector3.yAxis) or Vector3.zero local flat0v = Vector3.new(vel.X, 0, vel.Z) local flat0 = flat0v.Magnitude
	local slip0 = 0 if hasFwd and flat0 > 8 then slip0 = math.min(math.abs(flat0v:Dot(right)) / flat0, 1) end local braking = brakeHeld()
	local boosting = state.enabled and boostHeld() and (not braking) and hasFwd if boosting and impactF > 0 then boosting = false end
	if boosting and stab and cfg.boostCut and ((not grounded) or upDot < 0.7) then boosting = false end if boosting then local bf = fwd
		if seat:IsA("VehicleSeat") and seat.ThrottleFloat < 0 then bf = -fwd end local along = Vector3.new(vel.X, 0, vel.Z):Dot(bf)
		local remaining = cfg.maxSpeed - along if remaining > 0 then local traction = 1 if stab and cfg.tractionCtl then
				traction = math.clamp(1 - slip0 * 1.6 - math.clamp(math.abs(w.Y) / 3, 0, 1) * 0.5, 0, 1) end
			local accel = math.max(remaining * 1.5, cfg.maxSpeed * 0.1) * cfg.accelMult * traction local step = math.min(accel * dt, remaining)
			vel = vel + bf * step dirtyV = true end end if braking and grounded then if cfg.brakeInstant then vel = Vector3.new(0, vel.Y, 0) w = Vector3.zero
			dirtyW = true else local flat = Vector3.new(vel.X, 0, vel.Z) local m = flat.Magnitude if m > 0.05 then
				local nm = math.max(m - cfg.brakePower * dt, 0) local nf = flat / m * nm vel = Vector3.new(nf.X, vel.Y, nf.Z) else vel = Vector3.new(0, vel.Y, 0)
			end end dirtyV = true end local flatVel = Vector3.new(vel.X, 0, vel.Z) local flatSpeed = flatVel.Magnitude
	local along = hasFwd and flatVel:Dot(fwd) or 0 local steerDir = (held.right and 1 or 0) - (held.left and 1 or 0)
	local forceTurn = cfg.forceTurn or not seat:IsA("VehicleSeat") if steerDir ~= 0 and forceTurn and hasFwd and grounded then
		local mobility = math.clamp(along / 15, -1, 1) local rate = cfg.turnRate * steerFactor(flatSpeed) local yaw = -steerDir * rate * mobility
		w = Vector3.new(w.X, yaw, w.Z) vel = CFrame.Angles(0, yaw * dt, 0):VectorToWorldSpace(vel) dirtyW = true dirtyV = true end if stab then
		local sf = math.clamp(vel.Magnitude / math.max(cfg.stabStartSpeed, 1), 0, 3) local a = 1 - math.exp(-dt * 10) lpVy = lpVy + (vy0 - lpVy) * a
		lpW = lpW:Lerp(rest0, a) local targetN = grounded and normal or Vector3.yAxis normalS = normalS:Lerp(targetN, 1 - math.exp(-8 * dt))
		if normalS.Magnitude > 0.01 then normalS = normalS.Unit else normalS = Vector3.yAxis end if cfg.antiFlip then local targetGain = 1 - 0.8 * impactF
			alignGain = alignGain + (targetGain - alignGain) * (1 - math.exp(-5 * dt)) local align = upv:Dot(normalS) if align < 0.978 then local axis
				if align > -0.6 then axis = upv:Cross(normalS) else local s = look:Dot(upv:Cross(normalS)) if math.abs(s) > 0.05 then flipSign = s > 0 and 1 or -1
					end axis = look * flipSign end local k = 9 * str * (grounded and 1 or 0.6) * alignGain if align < 0.3 then k = k * 1.8 end
				local add = axis * (k * dt) if add.Magnitude > 0.12 then add = add.Unit * 0.12 end w = w + add local yawPart = Vector3.new(0, w.Y, 0)
				w = yawPart + (w - yawPart) * (1 - math.clamp(3.5 * str * dt, 0, 0.9)) local tilt = Vector3.new(w.X, 0, w.Z) if tilt.Magnitude > MAX_TILT_W then
					tilt = tilt.Unit * MAX_TILT_W w = Vector3.new(tilt.X, w.Y, tilt.Z) end dirtyW = true end end if cfg.antiShake then
			local k = math.clamp(0.35 * str * sf, 0, 0.7) if k > 0 then vel = Vector3.new(vel.X, vel.Y - (vy0 - lpVy) * k, vel.Z)
				local rest = Vector3.new(w.X, 0, w.Z) rest = rest - (rest0 - lpW) * k w = Vector3.new(rest.X, w.Y, rest.Z) dirtyV = true dirtyW = true end end
		if cfg.antiFly then if not grounded then local maxUp = (30 + flatSpeed * 0.1) / str if vel.Y > maxUp then vel = Vector3.new(vel.X, maxUp, vel.Z) end
			end local down = math.min(35 * str * sf, 120) if not grounded then down = down + 45 * str * math.clamp(sf, 0.3, 2) end if down > 0 then
				vel = vel - Vector3.yAxis * (down * dt) end dirtyV = true end if cfg.antiSlide and grounded and hasFwd then
			local fv = Vector3.new(vel.X, 0, vel.Z) local m = fv.Magnitude if m > 6 then local sgn = (fv:Dot(fwd) < -0.2 * m) and -1 or 1
				local rate = cfg.gripPower * str * (2 + 4 * sf) * (1 - 0.6 * impactF) local kk = 1 - math.exp(-rate * dt) local dirNow = fv / m
				local blend = dirNow:Lerp(fwd * sgn, kk) if blend.Magnitude > 0.01 then local slip = math.min(math.abs(fv:Dot(right)) / m, 1)
					local newM = m * (1 - 0.08 * kk * slip) local nv = blend.Unit * newM vel = Vector3.new(nv.X, vel.Y, nv.Z) dirtyV = true end end end
		if cfg.antiSpin then local steerAmt = math.abs(tele.steerIn) if steerDir ~= 0 then steerAmt = 1 end
			local fastF = math.clamp((flatSpeed - 40) / 120, 0, 1.5) if fastF > 0 and cfg.angDamp > 0 then
				local rate = cfg.angDamp * fastF * (steerAmt > 0.1 and 1.0 or 4.0) w = Vector3.new(w.X, w.Y * math.exp(-rate * dt), w.Z) dirtyW = true end
			local maxYaw = math.max(4 / (1 + flatSpeed / 70) / str, 0.3) if math.abs(w.Y) > maxYaw then local cap = maxYaw * (w.Y > 0 and 1 or -1)
				local newY = cap + (w.Y - cap) * math.exp(-14 * dt) w = Vector3.new(w.X, newY, w.Z) dirtyW = true end end end if guard and impactF > 0 then
		local maxUp = impactVy + 6 + (1 - impactF) * 25 if vel.Y > maxUp then vel = Vector3.new(vel.X, maxUp, vel.Z) dirtyV = true end
		local tilt = Vector3.new(w.X, 0, w.Z) * math.exp(-5 * impactF * dt) if tilt.Magnitude > MAX_TILT_W then tilt = tilt.Unit * MAX_TILT_W end
		w = Vector3.new(tilt.X, w.Y, tilt.Z) dirtyW = true end
	-- AUTO HOVER: at/above hoverKmh lift the whole car evenly by hoverHeight (0.2-0.5 studs) and cut friction on all car parts
	local hovering = false
	if cfg.hoverEnabled and rayParams then local kmh = Vector3.new(vel.X, 0, vel.Z).Magnitude * hover.K
		if hover.on then if kmh < cfg.hoverKmh * 0.95 then hover.on = false end elseif kmh >= cfg.hoverKmh then hover.on = true end else hover.on = false end
	hover.blend = math.clamp(hover.blend + (hover.on and dt or -dt) / 0.8, 0, 1)
	setHoverFriction(hover.blend > 0)
	if hover.blend > 0 and impactF <= 0 and upDot > 0.5 and rayParams then
		local hres = Workspace:Raycast(root.Position, Vector3.new(0, -60, 0), rayParams)
		if hres then local gap = hres.Distance - restOffset * math.max(upDot, 0.3)
			if gap < 4 then local gy = hres.Position.Y
				if hover.gy then local raw = math.clamp((gy - hover.gy) / math.max(dt, 0.004), -150, 150) hover.gv = hover.gv + (raw - hover.gv) * (1 - math.exp(-dt * 25))
				else hover.gv = 0 end hover.gy = gy
				local err = cfg.hoverHeight * hover.blend - gap local desVy = hover.gv + math.clamp(err * 25, -30, 30)
				local ka = 1 - math.exp(-dt * 30) vel = Vector3.new(vel.X, vel.Y + (desVy - vel.Y) * ka, vel.Z) dirtyV = true
				local kt = math.exp(-5 * dt) w = Vector3.new(w.X * kt, w.Y, w.Z * kt) dirtyW = true hovering = true
			else hover.gy = nil end
		else hover.gy = nil end
	else hover.gy = nil end
	tele.hover = hovering
	if dirtyV then root.AssemblyLinearVelocity = vel end if dirtyW then
		root.AssemblyAngularVelocity = w end prevVel = vel tele.boosting = boosting tele.braking = braking and grounded tele.flat = flatSpeed return speed0
end
local steerLastOut = nil
local steerEngine = 0
local steerAcc = 0
local function writeSteer(seat, floatValue, intValue) pcall(function() seat.SteerFloat = floatValue end) pcall(function() seat.Steer = intValue end)
end
RunService:BindToRenderStep(STEER_BIND, Enum.RenderPriority.Last.Value + 1, function() local seat = curSeat
	if not seat or not seat:IsA("VehicleSeat") or cfg.forceTurn then steerLastOut = nil steerAcc = 0 tele.steerIn = 0 return end
	local dir = (held.right and 1 or 0) - (held.left and 1 or 0) local okRead, sfv = pcall(function() return seat.SteerFloat end) if okRead then
		if steerLastOut == nil or math.abs(sfv - steerLastOut) > 1e-3 then steerEngine = sfv end end local raw = dir ~= 0 and dir or steerEngine
	tele.steerIn = raw local scaling = cfg.steerSense and cfg.seatSteerScale if dir ~= 0 or (scaling and math.abs(raw) > 1e-3) then local scaled = raw
		if scaling then scaled = raw * steerFactor(tele.flat) end local out if scaling and math.abs(scaled) < 0.98 then
			steerAcc = steerAcc + math.abs(scaled) out = 0 if steerAcc >= 1 then steerAcc = steerAcc - 1 out = scaled > 0 and 1 or -1 end else steerAcc = 0
			out = scaled > 0.01 and 1 or (scaled < -0.01 and -1 or 0) end writeSteer(seat, scaled, out) steerLastOut = scaled elseif steerLastOut ~= nil then
		steerLastOut = nil steerAcc = 0 writeSteer(seat, 0, 0) end end)
local statusTimer = 0
bind(RunService.Heartbeat, function(dt) dt = math.min(dt, 0.1) local seat = getSeat() local root = seat and seat.AssemblyRootPart curSeat = seat
	if seat ~= lastSeat then lastSeat = seat tele.boosting, tele.braking, tele.grounded, tele.crash, tele.hover = false, false, true, false, false
		tele.flat, tele.steerIn = 0, 0 steerLastOut, steerAcc = nil, 0 setHoverFriction(false) resetStabilityState() if seat then setupVehicle(seat, root)
			collectHoverParts(seat) else hover.parts = {} end end local speed = 0
	if seat and root and not root.Anchored then speed = driveVehicle(seat, root, dt) elseif root then speed = root.AssemblyLinearVelocity.Magnitude end
	statusTimer = statusTimer + dt if statusTimer >= 0.1 then statusTimer = 0 if seat then local flags = "" if tele.boosting then
				flags = flags .. "  BOOST" end if tele.braking then flags = flags .. "  BRAKE" end if tele.crash then flags = flags .. "  CRASH" end
			if tele.hover then flags = flags .. "  HOVER" end
			if cfg.stabEnabled and not tele.grounded then flags = flags .. "  AIR" end
			statusLabel.Text = ("Vehicle: seated%s\nSpeed: %d km/h%s"):format(cfg.stabEnabled and "  |  STAB" or "", math.floor(speed * hover.K + 0.5), flags) else
			statusLabel.Text = "Vehicle: none\nSit in a vehicle seat" end if tele.boosting then statusBar.BackgroundColor3 = cfg.colors.active
		elseif tele.crash then statusBar.BackgroundColor3 = cfg.colors.brakeBtn elseif tele.braking then statusBar.BackgroundColor3 = cfg.colors.brakeBtn
		else statusBar.BackgroundColor3 = seat and cfg.colors.accent or THEME.off end
		toggleBtn.BackgroundColor3 = state.enabled and cfg.colors.active or cfg.colors.aiBtn for _, h in ipairs(holdList) do h.refresh() end
		saveLabel.Text = saveInfo.text end end)
bind(UserInputService.InputBegan, function(input, gameProcessed) if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if rebinding then local field = rebinding local other = field == "boostKey" and "brakeKey" or "boostKey" if input.KeyCode == Enum.KeyCode.Escape then
			rebinding = nil refreshKeyButtons() elseif input.KeyCode == GUI_KEY then keyButtons[field].Text = "Reserved key"
		elseif input.KeyCode == cfg[other] then keyButtons[field].Text = "Already used" elseif input.KeyCode ~= Enum.KeyCode.Unknown then
			cfg[field] = input.KeyCode rebinding = nil keyHeld.boost, keyHeld.brake = false, false refreshKeyButtons() updateHint() end return end
	if gameProcessed then return end if input.KeyCode == cfg.boostKey then keyHeld.boost = true elseif input.KeyCode == cfg.brakeKey then
		keyHeld.brake = true elseif input.KeyCode == GUI_KEY then setOpen(not panelOpen) end end)
