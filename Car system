local hover = { on = false, blend = 0, gy = nil, gv = 0, parts = {}, orig = {}, fric = false, K = 0.28 * 3.6 } -- K: studs/s -> km/h
local function setHoverFriction(on) if on == hover.fric then return end hover.fric = on for i = #hover.parts, 1, -1 do local p = hover.parts[i]
		if p.Parent then pcall(function() if on then local cur = p.CurrentPhysicalProperties hover.orig[p] = { v = p.CustomPhysicalProperties }
				p.CustomPhysicalProperties = PhysicalProperties.new(cur.Density, 0, cur.Elasticity, 100, cur.ElasticityWeight)
			elseif hover.orig[p] then p.CustomPhysicalProperties = hover.orig[p].v hover.orig[p] = nil end end) end end
	if not on then hover.orig = {} end end
local function collectHoverParts(seat) hover.parts, hover.orig, hover.fric = {}, {}, false local seen = {} local function add(d)
		if d:IsA("BasePart") and d.CanCollide and not seen[d] and #hover.parts < 600 then seen[d] = true hover.parts[#hover.parts + 1] = d end end
	local ok, conn = pcall(function() return seat:GetConnectedParts(true) end) if ok and type(conn) == "table" then for _, d in ipairs(conn) do add(d) end end
	local model = seat:FindFirstAncestorOfClass("Model") if model then local desc = model:GetDescendants() if #desc <= 1500 then
			for _, d in ipairs(desc) do add(d) end end end end
