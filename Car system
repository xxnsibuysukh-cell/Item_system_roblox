local function round4(x) return math.floor(x * 10000 + 0.5) / 10000 end
local function colorToTable(c) return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) } end
local function tableToColor(t) if type(t) ~= "table" then return nil end local r, g, b = tonumber(t[1]), tonumber(t[2]), tonumber(t[3])
	if not (r and g and b) then return nil end return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255)) end
local function buildConfigData() local data = { version = CONFIG_VERSION, boostEnabled = state.enabled, boostKey = cfg.boostKey.Name,
		brakeKey = cfg.brakeKey.Name, maxSpeed = cfg.maxSpeed, colors = {}, positions = {}, } for k in pairs(NUM_LIMITS) do data[k] = cfg[k] end
	for _, k in ipairs(BOOL_KEYS) do data[k] = cfg[k] end for _, k in ipairs(COLOR_KEYS) do data.colors[k] = colorToTable(cfg.colors[k]) end
	local vp = viewport() for name in pairs(posMoved) do local obj = posTargets[name] if obj and vp.X > 0 and vp.Y > 0 then local p = obj.Position
			data.positions[name] = { round4((p.X.Scale * vp.X + p.X.Offset) / vp.X), round4((p.Y.Scale * vp.Y + p.Y.Offset) / vp.Y), } end end return data end
local function applyConfigData(data)
	if type(data.maxSpeed) == "number" and data.maxSpeed == data.maxSpeed and data.maxSpeed > 0 and data.maxSpeed < math.huge then
		cfg.maxSpeed = data.maxSpeed end for k, lim in pairs(NUM_LIMITS) do local v = data[k] if type(v) == "number" and v == v then
			cfg[k] = math.clamp(v, lim[1], lim[2]) end end for _, k in ipairs(BOOL_KEYS) do if type(data[k]) == "boolean" then cfg[k] = data[k] end end
	if type(data.boostEnabled) == "boolean" then state.enabled = data.boostEnabled end if type(data.colors) == "table" then
		for _, k in ipairs(COLOR_KEYS) do local c = tableToColor(data.colors[k]) if c then cfg.colors[k] = c end end end
	for _, field in ipairs(KEY_FIELDS) do local name = data[field] if type(name) == "string" then local ok, code = pcall(function()
				return Enum.KeyCode[name] end) if ok and code and code ~= Enum.KeyCode.Unknown and code ~= GUI_KEY then cfg[field] = code end end end
	if cfg.boostKey == cfg.brakeKey then cfg.boostKey = DEFAULTS.boostKey cfg.brakeKey = DEFAULTS.brakeKey end if type(data.positions) == "table" then
		for name in pairs(DEFAULT_POS) do local p = data.positions[name] if type(p) == "table" and tonumber(p[1]) and tonumber(p[2]) then
				loadedPos[name] = { math.clamp(tonumber(p[1]), 0, 1), math.clamp(tonumber(p[2]), 0, 1) } posMoved[name] = true end end end end
local function loadConfig() local raw if hasFS then pcall(function() if isfile(CONFIG_PATH) then raw = readfile(CONFIG_PATH) end end) else
		pcall(function() raw = shared[MEMORY_KEY] end) end if type(raw) ~= "string" or raw == "" then return false end local ok, data = pcall(function()
		return HttpService:JSONDecode(raw) end) if not ok or type(data) ~= "table" then return false end local applied = pcall(applyConfigData, data)
	return applied end
local lastEncoded = nil
local function saveNow(force) local okEnc, encoded = pcall(function() return HttpService:JSONEncode(buildConfigData()) end) if not okEnc then
		return false end if not force and encoded == lastEncoded then return true end local ok if hasFS then ok = pcall(function()
			if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
			writefile(CONFIG_PATH, encoded) end) else ok = pcall(function() shared[MEMORY_KEY] = encoded end) end if ok then lastEncoded = encoded
		saveInfo.text = ("Saved %s -> %s"):format(os.date("%H:%M:%S"), hasFS and CONFIG_PATH or "session memory only (no file access)") else
		saveInfo.text = "Save failed" end return ok end
