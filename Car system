local function makeDraggable(handle, target, onTap, posName) local dragging, moved = false, false local startInput, startPos
	handle.InputBegan:Connect(function(input) if isPress(input) then dragging, moved = true, false startInput = input.Position startPos = target.Position
			input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false if not moved and onTap then onTap() end
				end end) end end) bind(UserInputService.InputChanged, function(input) if dragging and isMove(input) then local d = input.Position - startInput
			if d.Magnitude > 4 then moved = true end if moved then markMoved(posName) local vp = viewport() local sz = target.AbsoluteSize
				local x = math.clamp(startPos.X.Offset + d.X, 0, math.max(vp.X - sz.X, 0))
