local function makeSlider(parent, order, text, min, max, value, step, fmt, onChange) local frame = new("Frame", { Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = THEME.card, BorderSizePixel = 0, LayoutOrder = order, }, parent) round(frame, 6) new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 14), Position = UDim2.fromOffset(8, 2), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, Text = text,
		TextColor3 = THEME.subtext, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, }, frame) local valueLabel = new("TextLabel", {
		Size = UDim2.new(0.4, -8, 0, 14), Position = UDim2.new(0.6, 0, 0, 2), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, Text = "",
		TextColor3 = THEME.text, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, }, frame) local track = new("TextButton", {
		Size = UDim2.new(1, -16, 0, 5), Position = UDim2.new(0, 8, 0, 21), BackgroundColor3 = THEME.header, Text = "", AutoButtonColor = false,
		BorderSizePixel = 0, }, frame) round(track, 3) local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, }, track)
	round(fill, 3) regAccent(fill, "BackgroundColor3") local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
		Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = THEME.text, BorderSizePixel = 0, ZIndex = 2, }, track) round(knob, 6)
	regAccent(stroke(knob, THEME.text, 2), "Color") local current = value local dragging = false local function render(v)
		local a = (v - min) / (max - min) valueLabel.Text = string.format(fmt, v) fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.fromScale(a, 0.5)
	end render(value) local function setFromX(x) local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min) v = math.clamp(math.floor(v / step + 0.5) * step, min, max) if v ~= current then current = v render(v) onChange(v)
		end end track.InputBegan:Connect(function(input) if isPress(input) then dragging = true lockScroll(track, true) setFromX(input.Position.X) end end)
	bind(UserInputService.InputChanged, function(input) if dragging and isMove(input) then setFromX(input.Position.X) end end)
	bind(UserInputService.InputEnded, function(input) if dragging and isPress(input) then dragging = false lockScroll(track, false) end end)
	local api = { frame = frame } function api.set(v) current = math.clamp(v, min, max) render(current) end return api end
